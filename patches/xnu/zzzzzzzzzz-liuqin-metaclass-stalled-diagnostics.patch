+extern "C" void liuqin_debug_puts(const char *);   // liuqin (H16-D): milestone console, see bsd/dev/liuqin_debug.c
+
+__attribute__((noinline)) static void
+liuqin_stalled_report(const char *phase, void *handle, unsigned count, void *first, void *second)
+{
+	char line[128];
+	__builtin_snprintf(line, sizeof line,
+	    "M:stalled %s h=%p cnt=%u c0=%p c1=%p\n", phase, handle, count, first, second);
+	liuqin_debug_puts(line);
+}
