+
+/*
+ * liuqin (H16-E): where each round actually died.
+ *   v35/v36c  postModLoad+0x288  -- the classes[] slot dereference itself
+ *   v37       postModLoad+0x2d4  -- one hop deeper: the first iteration of the depth
+ *                                  walk. Disassembly of the v37 image (function base
+ *                                  fffffff0078926a0) shows +0x2d4 is "ldr x24,[x24,#0x10]"
+ *                                  reached from the "no duplicate" branch at +0x2ac, with
+ *                                  x24 = 0x6131373030666666 (the bytes "ffff007a") and
+ *                                  far = x24 + 0x10. lr = +0x2ac is the return address of
+ *                                  the bl of sAllClassesDict->getObject, so classes[i] was
+ *                                  a live metaclass whose className read fine: what
+ *                                  carried ASCII text was its superClassLink field.
+ * The link-time superclass binding is NOT the problem -- the driver's MetaClass ctor
+ * loads &IOBlockStorageDevice::gMetaClass through its GOT slot and that slot holds
+ * fffffff007add1d0 in the shipped image -- so this is a runtime scribble, and the only
+ * way forward is to name the object. No OSKext calls here: OSKext::summaryForAddress()
+ * requires sKextSummariesLock and dereferences gLoadedKextSummaries, which is not
+ * populated this early in PE_init_iokit.
+ *
+ * OSMetaClass's private fields are reached through a layout mirror: OSMetaClassBase's
+ * vptr, then reserved, superClassLink, className, classSize. Both offsets used are
+ * confirmed against the v37 disassembly -- className is "ldr x1,[x24,#0x18]" and
+ * superClassLink is "ldr x24,[x24,#0x10]".
+ */
+struct liuqin_meta_shim {
+	const void      *vtable;
+	const void      *reserved;
+	const void      *superClassLink;
+	const void      *className;
+	unsigned int     classSize;
+};
+
+#define LIUQIN_KERNEL_TEXT_LO 0xfffffff000000000ULL
+#define LIUQIN_CHAIN_MAX      64
+
+static inline bool
+liuqin_ptr_ok(const void *p)
+{
+	return (uintptr_t)p >= LIUQIN_KERNEL_TEXT_LO;
+}
+
+/* Bounded print of a possibly-poisoned C string: never dereferences a bad pointer
+ * and never runs past the buffer. */
+__attribute__((noinline)) static void
+liuqin_puts_cstr(const char *s)
+{
+	char nb[72];
+	unsigned int j = 0;
+
+	if (liuqin_ptr_ok(s)) {
+		while (j < sizeof(nb) - 2 && s[j] != '\0') {
+			nb[j] = s[j];
+			j++;
+		}
+	}
+	nb[j++] = ' ';
+	nb[j] = '\0';
+	liuqin_debug_puts(nb);
+}
+
+/*
+ * Walk the ancestor chain without ever dereferencing an unvalidated pointer.
+ * Returns the number of hops on success; on failure returns -(hops before the
+ * bad link) and stores the bad value in *badOut.
+ */
+__attribute__((noinline)) static int
+liuqin_chain_depth(const OSMetaClass *entry, const void **badOut)
+{
+	const void      *cur = entry;
+	int              hops = 0;
+
+	*badOut = NULL;
+	while (cur) {
+		if (!liuqin_ptr_ok(cur)) {
+			*badOut = cur;
+			return -hops;
+		}
+		cur = ((const liuqin_meta_shim *)cur)->superClassLink;
+		hops++;
+		if (hops > LIUQIN_CHAIN_MAX) {
+			/* a chain this long is a cycle through poisoned memory */
+			*badOut = cur;
+			return -hops;
+		}
+	}
+	return hops;
+}
+
+/* One compact line naming the offending slot. Printed as a single trailing
+ * record so it is still on the panel when the panic screen redraws. */
+__attribute__((noinline)) static void
+liuqin_slot_dump(unsigned int i, const OSMetaClass *me, const void *bad, const char *why)
+{
+	const liuqin_meta_shim *sh = (const liuqin_meta_shim *)me;
+	char line[96];
+
+	__builtin_snprintf(line, sizeof line, "M:bad[%u]%s p=%p vt=%p sz=%u n=",
+	    i, why, (const void *)me, sh->vtable, sh->classSize);
+	liuqin_debug_puts(line);
+	liuqin_puts_cstr((const char *)sh->className);
+	__builtin_snprintf(line, sizeof line, "bad=%p\n", bad);
+	liuqin_debug_puts(line);
+}
